# Plantilla de configuración para graph_mailer.
# Copie este archivo a `.env` y complete los valores reales.
# El archivo `.env` NO debe versionarse (está en .gitignore).

# ID del tenant de Entra ID
GRAPH_TENANT_ID=

# ID de la aplicación registrada
GRAPH_CLIENT_ID=

# Secreto de la aplicación registrada
GRAPH_CLIENT_SECRET=

# Buzón de origen fijo desde el cual se envían los correos
GRAPH_SENDER_MAILBOX=

# Destinatario de prueba usado por el Test_CLI
GRAPH_TEST_RECIPIENT=
